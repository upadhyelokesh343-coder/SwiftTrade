{
  "collections": {
    "users": {
      "documents": {
        "{userId}": {
          "fields": {
            "demoBalance": "number",
            "realBalance": "number",
            "activeAsset": "string",
            "updatedAt": "timestamp"
          }
        }
      }
    },
    "trades": {
      "documents": {
        "{tradeId}": {
          "fields": {
            "userId": "string",
            "asset": "string",
            "action": "string",
            "entryPrice": "number",
            "amount": "number",
            "createdAt": "timestamp",
            "expiryTime": "timestamp",
            "status": "string",
            "resultPrice": "number",
            "profit": "number"
          }
        }
      }
    },
    "notifications": {
      "documents": {
        "{notificationId}": {
          "fields": {
