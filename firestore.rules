rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is the site admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'rajsjarma8@gmail.com' ||
        request.auth.token.email == 'rajsharma8@gmail.com' ||
        request.auth.token.email.matches('(?i)rajsjarma8@gmail.com') ||
        request.auth.token.email.matches('(?i)rajsharma8@gmail.com') ||
        request.auth.token.email.matches('(?i).*admin.*')
      );
    }

    match /users/{userId} {
      allow read, write: if true;
    }
    
    match /trades/{tradeId} {
      allow read, write: if true;
    }

    match /config/{configId} {
      allow read, write: if true;
    }

    match /deposits/{depositId} {
      allow read, write: if true;
    }

    match /withdrawals/{withdrawalId} {
      allow read, write: if true;
    }

    match /support_messages/{messageId} {
      allow read, write: if true;
    }

    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    match /market_control/{docId} {
      allow read, write: if true;
    }
  }
}
